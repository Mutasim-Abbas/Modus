# Vercel's zero-config function detection turns EVERY non-underscore-prefixed
# .ts file under api/ into its own Serverless Function — including *.test.ts files
# that sit next to the route they test (api/analyze-meal.test.ts, api/auth/*.test.ts,
# api/sync/*.test.ts). Files under api/_lib/** are already skipped automatically by
# Vercel's underscore convention (see api/_lib/http.ts's header comment), but files
# directly in api/, api/auth/ and api/sync/ are not.
#
# Without this line, deployment would try to ship ~11 extra "functions" that import
# vitest/@electric-sql/pglite and have no fetch handler, on top of the 11 real routes
# — comfortably over the Hobby plan's 12-Serverless-Function-per-deployment cap.
# Verified against the project plan's "Vercel function count" section; see there for
# the exact count and how it was derived. This does not affect local `npm test`,
# which runs against the full git checkout, not this file.
api/**/*.test.ts
