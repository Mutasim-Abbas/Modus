# Copy to .env.local for local development. NEVER commit a real key — .gitignore blocks it.
#
# Used only by the serverless function (api/analyze-meal.ts), server-side.
# It is never bundled into the client and never sent to the browser.
#
# Get a key at https://console.groq.com  →  API Keys. Groq's free tier is genuinely free
# (no card), which is why the vision model runs there.
# In production, set this in Vercel: Project → Settings → Environment Variables.
#
# When this is unset, the app still works fully — the AI scan feature disables itself
# and returns 503 { "error": "ai_unconfigured" }. Nothing breaks.
GROQ_API_KEY=

# Neon Postgres connection string (HTTP driver, @neondatabase/serverless). Create a free
# project at https://neon.tech — free tier is permanent (0.5 GB, autosuspend + auto-resume).
# When this is unset, the auth/sync endpoints must return 503 { "error": "sync_unconfigured" }
# and the app must still work fully in guest mode — see the project plan.
DATABASE_URL=

# 32-byte random secret used to key the SHA-256 hash of session tokens at rest (never the
# token itself). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this value across environments; rotating it invalidates every live session.
SESSION_PEPPER=
